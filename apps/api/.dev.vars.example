# Локальные секреты для `wrangler dev` (НЕ коммитить — .dev.vars в .gitignore).
# Реальные значения задаются в проде через `wrangler secret put`.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
# Числовой Telegram ID владельца (узнать: написать боту /id). Можно оставить пустым.
OWNER_TELEGRAM_ID=
