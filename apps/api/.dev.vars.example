# Локальные секреты для `wrangler dev` (НЕ коммитить — .dev.vars в .gitignore).
# Реальные значения задаются в проде через `wrangler secret put`.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Оба секрета ниже — случайные строки; сгенерировать:
#   openssl rand -hex 32
#   …или на Windows без OpenSSL: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
# Числовой Telegram ID владельца (узнать: написать боту /id). Можно оставить пустым.
OWNER_TELEGRAM_ID=
# Vision (шаг 7): распознавание скриншотов банка. Основной провайдер — Gemini
# (aistudio.google.com, free tier), резерв — Groq (console.groq.com).
# Задайте хотя бы один, иначе бот отвечает «распознавание не настроено».
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# DATA_KEY — мастер-ключ шифрования данных в D1 (base64, ровно 32 байта).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ ПОТЕРЯ = необратимая потеря данных: без ключа шифртекст не расшифровать.
# Без него /telegram/* и /api/tma/* отвечают 503 (fail-closed).
# Значение ниже — 32 нулевых байта в base64, ВАЛИДНО для dev (для прода — свой!).
DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Автоцены крипты (T3b): Demo-ключ CoinGecko (coingecko.com → Developer Dashboard).
# Без ключа внешних запросов нет — цены остаются ручными. В проде: wrangler secret put COINGECKO_API_KEY
COINGECKO_API_KEY=
