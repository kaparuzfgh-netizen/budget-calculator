# Корневой .env для скриптов (scripts/env.mjs): setup, webhook:*, release.
# Копия: cp .env.example .env  (.env в .gitignore — НЕ коммитить).
# Явные переменные окружения важнее файла; пустой/отсутствующий .env — не ошибка.
# Секреты воркера в проде задаются через `wrangler secret put`, локально
# для `wrangler dev` — в apps/api/.dev.vars (шаблон: apps/api/.dev.vars.example).

# Токен бота от @BotFather. Если не задан — мастер `npm run setup` спросит один раз.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Секрет webhook (X-Telegram-Bot-Api-Secret-Token) для `npm run webhook:set`.
# Должен совпадать с секретом воркера. Сгенерировать:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
TELEGRAM_WEBHOOK_SECRET=change-me
