{
  "name": "budget-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Finance Companion — Telegram-бот и Mini App личных финансов (Cloudflare Workers + D1)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:api && npm run test:web",
    "wrangler": "npm exec -w apps/api -- wrangler",
    "lint": "eslint scripts apps",
    "lint:sh": "node scripts/lint-sh.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup": "node scripts/setup.mjs",
    "setup:staging": "node scripts/setup.mjs --env staging",
    "release": "node scripts/release.mjs",
    "release:staging": "node scripts/release.mjs --env staging",
    "webhook:set": "node scripts/telegram-webhook.mjs set",
    "webhook:info": "node scripts/telegram-webhook.mjs info",
    "webhook:delete": "node scripts/telegram-webhook.mjs delete",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "build:web": "npm run build -w apps/web",
    "check": "npm run lint && npm run typecheck && npm run test:api && npm run test:web && npm run build:web",
    "prepare": "node scripts/install-hooks.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.7"
    }
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
