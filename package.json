{
  "name": "budget-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Finance Companion — serverless-движок личных финансов (Telegram + Apps Script + Google Sheets)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "build:bundle": "node scripts/build-bundle.js",
    "lint": "node scripts/build-bundle.js --quiet && eslint scripts dist/BUNDLE.gs",
    "lint:sh": "node scripts/lint-sh.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test",
    "push": "clasp push",
    "deploy": "node scripts/deploy.js",
    "bootstrap": "node scripts/bootstrap.js",
    "prepare": "node scripts/install-hooks.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@google/clasp": "^3.4.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10"
  }
}
